# Copy to .env and adjust. .env is git-ignored; this file is not.
#
# Local development passwords come from infra/db/bootstrap.sql. They are not
# secrets: a clean clone has to be able to run (requirement B6).

PORT=3002
DATABASE_URL=postgres://payments_user:payments_pw@localhost:5432/payments_db

# How often an undelivered InvoicePaid notification is retried.
NOTIFY_RETRY_SECONDS=5
