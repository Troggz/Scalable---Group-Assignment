# Copy to .env and adjust. These local development credentials are created by
# infra/db/bootstrap.sql; Studio never connects to another service's database.
PORT=3003
DATABASE_URL=postgres://studio_user:studio_pw@localhost:5432/studio_db

# Studio asks Payments for the pelunasan invoice over HTTP.
PAYMENTS_URL=http://localhost:3002

# Payments uses this address to send InvoicePaid back to Studio.
PUBLIC_URL=http://localhost:3003
