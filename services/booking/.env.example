# Copy to .env and adjust. .env is git-ignored; this file is not.
#
# Local development passwords come from infra/db/bootstrap.sql. They are not
# secrets: a clean clone has to be able to run (requirement B6).

PORT=3001
DATABASE_URL=postgres://booking_user:booking_pw@localhost:5432/booking_db

# Neighbours are known by URL only, never by database connection.
PAYMENTS_URL=http://localhost:3002
STUDIO_URL=http://localhost:3003

# How payments reaches us back with InvoicePaid.
PUBLIC_URL=http://localhost:3001

# Real: 1440 (1x24 hours). Set to 3 for the screencast so expiry is watchable.
DP_DEADLINE_MINUTES=1440
